{
    "provider": "anthropicai",
    "anthropicai": {
        "model": "claude-sonnet-4-5-20250929",
        "temperature": 0.7,
        "max_tokens": 1024
    },
    "openai": {
        "model": "gpt-4o-mini",
        "temperature": 0.7,
        "max_tokens": 300,
